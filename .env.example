# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres connection string from Neon (https://neon.tech) - looks like:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URI=

# Site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Image storage (Vercel Blob: create a Blob store in your Vercel project's Storage tab).
# Leave blank for local dev - uploads fall back to local disk automatically.
BLOB_READ_WRITE_TOKEN=

# Email notifications for form submissions (Resend: https://resend.com)
# Leave blank to skip emailing and rely on the /admin dashboard only.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
NOTIFICATION_EMAIL_TO=info@tiacademy.com

# Stripe donations (https://dashboard.stripe.com/apikeys) - test keys are fine to start
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
